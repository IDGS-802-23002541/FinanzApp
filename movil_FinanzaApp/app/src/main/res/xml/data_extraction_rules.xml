<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de extracción: el token de sesión queda fuera de la copia en la nube
   y de la transferencia entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion_finanzapp.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion_finanzapp.xml" />
    </device-transfer>
</data-extraction-rules>
